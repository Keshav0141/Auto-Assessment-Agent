# --- LLM Provider (OpenAI-compatible, supports Goedel Machines / Gemini / OpenAI) ---
LLM_PROVIDER=openai                 # openai | mock

# Grading LLM (text). Option A: DeepSeek V4.1 Flash via Goedel Machines (free; prompts are retained - test data only)
OPENAI_BASE_URL=https://api.goedelmachines.com/v1
OPENAI_API_KEY=
LLM_MODEL=deepseek/deepseek-v4.1-flash
LLM_DISABLE_THINKING=true
LLM_NATIVE_N=true
LLM_REQUEST_PACING=1

# Option B: Gemini
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OPENAI_API_KEY=
# LLM_MODEL=gemini-3.5-flash-lite
# LLM_DISABLE_THINKING=false
# LLM_NATIVE_N=false

# --- Grading ---
GRADING_TEMPERATURE=0.7             # sampling temperature for confidence scoring
LLM_MAX_RETRIES=5
GRADE_WORKERS=4                      # parallel question-grading threads
ADJUDICATE=true                     # referee the primary + second grading when they disagree
FEEDBACK_LANGUAGE=auto              # auto (student's answer language) | en | a language code or name (hi, Tamil, ...)

# --- Confidence scoring ---
CONFIDENCE_SAMPLES=3                # N sampled grading calls per question
CONFIDENCE_THRESHOLD=0.85            # flag questions below this confidence
W_AGREE=0.4                         # weight for sample-agreement confidence
W_VARIANCE=0.2                      # weight for score-variance confidence
W_SEMANTIC=0                        # weight for semantic-consistency confidence
W_CROSS=0.3                         # weight for cross-model (second-grader) confidence
CLUSTER_THRESHOLD=0.72              # cosine threshold for feedback clustering
ERROR_MARGIN=0.5                    # marks difference counted as a grading error (eval)

# --- Second grader (optional cross-model check; skipped if JUDGE2_API_KEY is empty) ---
JUDGE2_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
JUDGE2_API_KEY=
JUDGE2_MODEL=gemini-3.5-flash-lite

# --- Referee (optional; adjudicates primary vs second grader. Every field defaults to the primary LLM) ---
REFEREE_BASE_URL=
REFEREE_API_KEY=
REFEREE_MODEL=
REFEREE_EXTRA_BODY=                 # optional JSON request flags for the referee only

# --- Fallback grader (optional; used when the primary fails after retries, before the second grader) ---
FALLBACK_BASE_URL=                  # defaults to OPENAI_BASE_URL
FALLBACK_API_KEY=                   # defaults to OPENAI_API_KEY
FALLBACK_MODEL=                     # set this to enable the fallback
FALLBACK_EXTRA_BODY=                # optional JSON request flags for the fallback only

# --- Embeddings (optional: sentence-transformers model name) ---
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- OCR (scanned answer sheets / images) ---
OCR_PROVIDER=auto              # auto | vision (alias: gemini) | tesseract | bodhan (bodhan: pending access)
OCR_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OCR_API_KEY=                   # Gemini key - DeepSeek is text-only, cannot OCR
OCR_MODEL=gemini-3.5-flash-lite
OCR_EXTRA_BODY=                # optional JSON merged into the OCR request body (e.g. {"reasoning":{"effort":"none"}} for OpenRouter); overrides OCR_DISABLE_THINKING

# --- Bodhan IndicOCR (optional; the backend is a stub until its API is wired up) ---
BODHAN_BASE_URL=
BODHAN_OCR_KEY=
BODHAN_OCR_MODEL=
