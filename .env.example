# --- LLM Provider (OpenAI-compatible, supports OpenCode Zen / DeepSeek / Gemini / OpenAI) ---
LLM_PROVIDER=openai                 # openai | mock

# Option A: Google Gemini (recommended - fast free tier)
# Get a key: https://aistudio.google.com/apikey  (use gemini-3.5-flash-lite or
# gemini-3.5-flash for free tier; gemini-2.0-flash is retired from free tier)
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_API_KEY=                     # paste your Google AI Studio key here
LLM_MODEL=gemini-3.5-flash-lite

# Option B: OpenCode Zen (free, but heavily rate-limited -> slower)
# OPENAI_BASE_URL=https://opencode.ai/zen/v1
# OPENAI_API_KEY=
# LLM_MODEL=deepseek-v4-flash-free

# Option C: DeepSeek Official
# OPENAI_BASE_URL=https://api.deepseek.com
# OPENAI_API_KEY=
# LLM_MODEL=deepseek-v4-flash

# --- Grading ---
GRADING_TEMPERATURE=0.7             # sampling temperature for confidence scoring
LLM_MAX_RETRIES=5

# --- Confidence scoring ---
CONFIDENCE_SAMPLES=3                # N sampled grading calls per question
CONFIDENCE_THRESHOLD=0.6            # flag questions below this confidence
W_VARIANCE=0.5                      # weight for score-variance confidence
W_SEMANTIC=0.5                      # weight for semantic-consistency confidence
CLUSTER_THRESHOLD=0.72              # cosine threshold for feedback clustering
ERROR_MARGIN=0.5                    # marks difference counted as a grading error (eval)

# --- Embeddings (optional: sentence-transformers model name) ---
EMBEDDING_MODEL=all-MiniLM-L6-v2
LLM_REQUEST_PACING=1                # seconds to wait between sampled LLM calls (Gemini ~1s, Zen 4s+)
